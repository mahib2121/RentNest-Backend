model Category {
  id          String   @id @default(uuid())

  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(60)
  description String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  properties Property[]

  @@map("categories")
}